{
  "appId": "com.devsweep.app",
  "productName": "DevSweep",
  "copyright": "Copyright © 2026 DevSweep Contributors",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "build/icon.ico",
    "build/icon.png",
    "public/icon.png",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "executableName": "DevSweep",
    "artifactName": "DevSweep Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DevSweep",
    "uninstallDisplayName": "DevSweep",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "deleteAppDataOnUninstall": false
  },
  "portable": {
    "artifactName": "DevSweep-Portable.${ext}"
  }
}
