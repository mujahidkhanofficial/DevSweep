{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": true,
    "paths": {
      "@cleaner/shared": ["./packages/shared/src/index.ts"],
      "@cleaner/safety-engine": ["./packages/safety-engine/src/index.ts"],
      "@cleaner/cleanup-rules": ["./packages/cleanup-rules/src/index.ts"],
      "@/*": ["./apps/desktop/src/*"]
    }
  },
  "include": ["packages/**/*", "tests/**/*", "apps/**/*"]
}
